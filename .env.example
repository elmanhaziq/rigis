# Copy to .env.local for local development, and set the same variables in
# Cloudflare Pages → Settings → Environment variables for deployments.

# Public origin of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://rigis.pages.dev

# Supabase (Phase 2). Only the public URL and the anon/publishable key belong
# here — they are embedded in browser code by design and protected by RLS.
# NEVER put the service-role key in any NEXT_PUBLIC_ variable or in this repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
